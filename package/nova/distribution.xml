<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Nova 星语输入法</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="13.0"/>
    <choices-outline>
        <line choice="nova"/>
    </choices-outline>
    <choice id="nova" visible="false">
        <pkg-ref id="im.nova.inputmethod.NovaSquirrel"/>
    </choice>
    <pkg-ref id="im.nova.inputmethod.NovaSquirrel" version="VERSION" onConclusion="none">nova-component.pkg</pkg-ref>
</installer-gui-script>
